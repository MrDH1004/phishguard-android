<?xml version="1.0" encoding="utf-8"?>
<!-- 가족 연결 토큰이 클라우드 백업이나 새 폰으로 옮기기(기기 간 이전)로 복제되지 않게 제외한다. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="family.xml" />
        <exclude domain="sharedpref" path="family_pending.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="family.xml" />
        <exclude domain="sharedpref" path="family_pending.xml" />
    </device-transfer>
</data-extraction-rules>
